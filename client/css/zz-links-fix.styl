@import colors

// Final overrides to ensure links are visible on dark backgrounds.
// This file is named to come last in the compiled order so it overrides
// earlier declarations.

a
    color: $text-color !important
    text-decoration: underline !important

body.darktheme a
    color: $text-color-darktheme !important
    text-decoration: underline !important

// Ensure tag/pool anchors keep their configured class colors; make other
// anchors in darktheme inherit the readable text color even if a later
// global `a` rule sets black.
body.darktheme a:not([class^="tag-"]):not([class*=" tag-"]):not([class^="pool-"]):not([class*=" pool-"])
    color: $text-color-darktheme !important
    text-decoration: underline !important

// Explicitly make source/search links in the post sidebar readable.
body.darktheme .post-view .readonly-sidebar .details .source a,
body.darktheme .post-view .readonly-sidebar .details .search a
    color: $text-color-darktheme !important
    text-decoration: underline !important
